{
  "description": "Processes pending and due-failed owner notification events and sends emails every 5 minutes with bounded retry.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Deliver Owner Notifications",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deliver_owner_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "deliver": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deliverOwnerNotifications"
          },
          "then": "end",
          "x-base44": {
            "title": "Deliver due notification events",
            "description": "Send emails with bounded retry"
          }
        }
      }
    ]
  }
}