{
  "name": "WalletTrial",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "The wallet address exactly as submitted by the visitor."
    },
    "normalized_wallet_address": {
      "type": "string",
      "description": "Lowercased (EVM) or canonical (Solana) address used for lookups."
    },
    "network": {
      "type": "string",
      "enum": [
        "ethereum",
        "base",
        "solana"
      ],
      "description": "The chain the wallet was analyzed on."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "analyzing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "demo",
      "description": "Evidence completeness: demo = fixtures; live = real Nansen evidence (partial cases carry _meta.partial=true in metrics_json)."
    },
    "case_outcome": {
      "type": "string",
      "enum": [
        "verdict",
        "dismissed_no_evidence",
        "mistrial_insufficient_evidence",
        "demo"
      ],
      "description": "Active case outcome classification (Phase N2.3). verdict = deterministic verdict issued; dismissed_no_evidence = successful empty evidence profile; mistrial_insufficient_evidence = activity too thin to defensibly verdict; demo = fixture verdict. Absent on pre-N2.3 records (inferred as verdict/demo)."
    },
    "wallet_class": {
      "type": "string",
      "description": "Machine wallet class code from Nansen address labels (cex_exchange, market_maker, mev_bot, protocol_treasury, fund_institution, trader_individual, unknown). Public-safe; never stores raw labels or personal names. Absent on pre-N2 cases."
    },
    "verdict_code": {
      "type": "string",
      "description": "Machine code of the canonical verdict, e.g. one_pump_chump. Null for dismissed/mistrial outcomes."
    },
    "verdict_name": {
      "type": "string",
      "description": "Display name of the verdict, e.g. One Pump Chump. Null for dismissed/mistrial outcomes."
    },
    "severity_score": {
      "type": "number",
      "description": "0-100. Higher = more egregious trading behavior. Null for dismissed/mistrial outcomes."
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100. How confident the court is in the verdict. Null for dismissed/mistrial outcomes."
    },
    "headline": {
      "type": "string"
    },
    "roast": {
      "type": "string",
      "description": "The cheeky courtroom roast of the wallet's behavior. Null for dismissed/mistrial outcomes."
    },
    "defense_statement": {
      "type": "string",
      "description": "The wallet's (imagined) defense, entered into the record. Null for dismissed/mistrial outcomes."
    },
    "sentence": {
      "type": "string"
    },
    "evidence_items_json": {
      "type": "string",
      "description": "JSON array of evidence exhibit objects. Preserved on dismissed/mistrial cases for audit; not displayed as active evidence on dismissed cases."
    },
    "metrics_json": {
      "type": "string",
      "description": "JSON object of numeric trading metrics, with _meta carrying partial/failed_sources/window metadata. Preserved unchanged across re-score and evidence-gate migrations."
    },
    "source_endpoints_json": {
      "type": "string",
      "description": "JSON array of the Nansen (or demo) endpoints consulted."
    },
    "public_slug": {
      "type": "string",
      "description": "Unique slug for the permanent public case page."
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "rescore_audit_json": {
      "type": "string",
      "description": "JSON audit note for deterministic re-score / evidence-gate migrations. Records phase, operation, evidence source, migration type, timestamp, and previous/next state. Internal-only; never exposed on the public case page."
    }
  },
  "required": [
    "wallet_address",
    "network"
  ]
}