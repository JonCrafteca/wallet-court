{
  "name": "VerdictTemplate",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine code, e.g. one_pump_chump."
    },
    "display_name": {
      "type": "string",
      "description": "Stamped verdict name shown to visitors."
    },
    "description": {
      "type": "string",
      "description": "Plain-language definition of the verdict."
    },
    "severity_min": {
      "type": "number",
      "description": "Inclusive lower bound of the severity band this verdict covers."
    },
    "severity_max": {
      "type": "number",
      "description": "Inclusive upper bound of the severity band this verdict covers."
    },
    "criteria_json": {
      "type": "string",
      "description": "JSON describing the deterministic criteria that trigger this verdict."
    },
    "headline_options_json": {
      "type": "string",
      "description": "JSON array of candidate headlines."
    },
    "roast_options_json": {
      "type": "string",
      "description": "JSON array of candidate roast paragraphs."
    },
    "defense_options_json": {
      "type": "string",
      "description": "JSON array of candidate defense statements."
    },
    "sentence_options_json": {
      "type": "string",
      "description": "JSON array of candidate sentences."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "display_name"
  ]
}